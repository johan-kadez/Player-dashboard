rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /players/{playerId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    match /registrations/{registrationId} {
      allow create: if
        request.resource.data.status == "pending" &&
        request.resource.data.name is string &&
        request.resource.data.playerId is string &&
        request.resource.data.tiktok is string &&
        request.resource.data.wa is string &&
        get(/databases/$(database)/documents/settings/registration).data.open == true &&
        get(/databases/$(database)/documents/settings/registration).data.currentParticipants <
          get(/databases/$(database)/documents/settings/registration).data.maxParticipants;
      allow read, update, delete: if signedIn();
    }

    match /settings/registration {
      allow read: if true;
      allow create: if signedIn();
      allow update: if signedIn();
    }
  }
}