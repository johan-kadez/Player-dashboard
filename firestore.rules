rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /players/{playerId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    // Public can submit a registration, but cannot read registrations.
    // The quota document must exist and must show that registration is open.
    match /registrations/{registrationId} {
      allow create: if
        request.resource.data.status == "pending" &&
        request.resource.data.name is string &&
        request.resource.data.playerId is string &&
        request.resource.data.tiktok is string &&
        request.resource.data.wa is string &&
        exists(/databases/$(database)/documents/settings/registration) &&
        get(/databases/$(database)/documents/settings/registration).data.open == true &&
        get(/databases/$(database)/documents/settings/registration).data.currentParticipants <
          get(/databases/$(database)/documents/settings/registration).data.maxParticipants;

      // Only authenticated users can view/process registrations.
      allow read, update, delete: if signedIn();
    }

    // Public needs to read quota status. Only authenticated users may create/update it.
    match /settings/registration {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if signedIn();
    }
  }
}
